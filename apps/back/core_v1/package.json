    "test:unit": "jest --config jest.config.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.3",
    "@fastify/sensible": "^6.0.2",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "bcrypt": "^5.1.1",
    "fastify": "^5.2.1",
    "fastify-swagger": "^5.2.0",
    "fastify-zod": "^1.4.0",
    "http-status-codes": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@prisma/client": "^6.3.1",
    "@types/bcrypt": "^5.0.2",
    "nodemon": "^3.1.9",
    "prisma": "^6.3.1",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0"
  }
